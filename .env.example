# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: API token for webhook authentication
API_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (empty = allow all)
# On first run, these are seeded into the DB. After that, manage via /adduser and /rmuser.
ALLOWED_USERS=

# Master admin user ID — can manage whitelist via /users, /adduser, /rmuser
MASTER_ADMIN=
